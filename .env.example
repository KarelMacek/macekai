SECRET_KEY=django-insecure-local-dev-only
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL — leave unset for local SQLite dev. docker-compose.yml sets these
# automatically to talk to its own `db` service; only override here if pointing
# at a different Postgres instance.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=

# Azure AD / Entra ID (Easy Auth) — optional for local dev, required in production
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_TENANT_ID=

# The one admin (Karel) — this email gets is_staff on login, granting /admin/
# access for authoring/reviewing assessments. Leave unset locally; DEBUG's
# dev-login already grants a staff "dev" user without this.
ADMIN_EMAIL=

# SimpleShop.cz purchase webhook + gating — see assessments/webhooks.py.
# Leave SECRET unset locally; a blank secret rejects every webhook call.
# Use `python manage.py open_diagnostics <email>` instead of a real webhook
# call for local testing. PURCHASE_URL may stay blank — the app falls back
# to a "contact to purchase" message when it's unset.
SIMPLESHOP_WEBHOOK_SECRET=
DIAGNOSTICS_PURCHASE_URL=

# Per-environment copies of the same secret above, for
# app-backend/scripts/simulate_simpleshop_webhook.py to call a REAL deployed
# environment's webhook endpoint remotely (dev/staging testing, or granting
# an existing prod client access without a real purchase). Same values as
# each environment's Key Vault "simpleshop-webhook-secret" — not used by the
# Django app itself, only by that script.
SIMPLESHOP_WEBHOOK_SECRET_DEV=
SIMPLESHOP_WEBHOOK_SECRET_STAGING=
SIMPLESHOP_WEBHOOK_SECRET_PROD=

# Microsoft Graph sendMail (app-only auth) — see backend/graph_mail.py.
# Sends the post-purchase instructions email when the SimpleShop webhook
# fires. Leave unset locally; nothing calls it outside the real webhook path.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
EMAIL_FROM_ADDRESS=

# Public URL used to build links in outgoing emails — see
# assessments/emailing.py. Leave unset locally; falls back to ALLOWED_HOSTS[0].
# Set per-environment by infra/modules/web_app/main.tf in real deployments.
APP_URL=

# Tavily — optional, only needed once/if app-backend actually calls it.
TAVILY_API_KEY=

# Azure OpenAI — optional, only needed once/if app-backend actually calls it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
