SECRET_KEY=django-insecure-local-dev-only
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL — leave unset for local SQLite dev. docker-compose.yml sets these
# automatically to talk to its own `db` service; only override here if pointing
# at a different Postgres instance.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=

# Azure AD / Entra ID (Easy Auth) — optional for local dev, required in production
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_TENANT_ID=

# Tavily — optional, only needed once/if app-backend actually calls it.
TAVILY_API_KEY=

# Azure OpenAI — optional, only needed once/if app-backend actually calls it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
